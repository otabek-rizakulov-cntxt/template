# Build context exclusions.
#
# NOTE: `src` and `prisma` must NOT be listed here — the build stage compiles
# from them. Excluding `src` previously produced an image with no application
# code in it.

node_modules
dist
build
coverage

.git
.gitignore
.github

Dockerfile
.dockerignore
docker-compose.yml

# Never bake real secrets into an image layer.
.env
.env.*
!.env.example

*.log
npm-debug.log
pnpm-debug.log
.DS_Store
.vscode
.idea

architecture-review.pptx
