# Copy to .env and fill in. Every value below is validated at boot by
# src/infrastructure/config/environment-config/environment-config.validation.ts
# — the application refuses to start if one is missing or malformed.

# One of: development | production | local | test
NODE_ENV=development

# --- HTTP ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=3000

# Comma-separated exact origins allowed to send credentialed requests.
# Leave empty to allow none. Do NOT use "*" — cookies are used for auth.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database -----------------------------------------------------------
# Host port docker-compose publishes Postgres on. Change it if 5432 is already
# in use locally; it does not affect addressing inside the compose network.
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template?schema=public

# --- Tokens -------------------------------------------------------------
# Minimum 32 characters each, and the two secrets must differ.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_TOKEN_SECRET=replace-me-too-with-32-plus-random-characters

# Lifetimes in seconds: 15 minutes access, 7 days refresh.
JWT_EXPIRATION_TIME=900
JWT_REFRESH_TOKEN_EXPIRATION_TIME=604800
